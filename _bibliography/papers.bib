  title={MAAN: Multi-channel Adaptive Attention Network for Probabilistic Time Series Forecasting},
  booktitle={SIAM International Conference on Data Mining (SDM)},
  author={Odum, J. and Miller, J. A.},
  abstract={Introduces the Causal Cross-Modal Adapter, operating in two modes: a latent funnel for high-dimensional covariates and a noise-adaptive causal graph for low-dimensional covariates. Joint-window training with selective noising and a masked diffusion loss give stable multi-step probabilistic forecasting.},
  year={2026},
  note={Accepted},
}

