<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Inter Font -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

  <!-- Favicon -->
  {% if site.icon contains '://' %}
    <link rel="shortcut icon" href="{{ site.icon }}">
  {% else %}
    <link rel="shortcut icon" href="{{ site.icon | prepend: '/assets/img/' | relative_url }}">
  {% endif %}

  <style>
    body { font-family: 'Inter', system-ui, -apple-system, sans-serif; }

    /* Subtle radial glow background */
    .bg-glow {
      background:
        radial-gradient(ellipse at 20% 50%, rgba(251, 146, 60, 0.06) 0%, transparent 60%),
        radial-gradient(ellipse at 80% 20%, rgba(251, 146, 60, 0.04) 0%, transparent 50%),
        #030712;
    }

    /* Card hover effects */
    .bento-card {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .bento-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    }

    /* Glassmorphism */
    .glass {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    /* Gradient button */
    .btn-gradient {
      background: radial-gradient(circle, #ea580c, #fb923c 80%);
      box-shadow: 0 0 14px rgba(249, 115, 22, 0.5);
      transition: all 0.2s ease;
    }
    .btn-gradient:hover {
      transform: scale(1.05);
      box-shadow: 0 0 20px rgba(249, 115, 22, 0.7);
    }
    .btn-gradient .btn-glow-inner {
      box-shadow: inset 0 3px 12px rgba(251, 146, 60, 0.9), inset 0 -3px 4px rgba(254, 215, 170, 0.8);
    }

    /* Skill pill hover */
    .skill-pill {
      transition: all 0.2s ease;
    }
    .skill-pill:hover {
      border-color: #f97316;
      background: rgba(249, 115, 22, 0.15);
      color: #fb923c;
      transform: scale(1.05);
    }

    /* Scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #1c1917; }
    ::-webkit-scrollbar-thumb { background: #44403c; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #57534e; }

    /* About content prose */
    .prose-bento h2 {
      font-size: 1.25rem;
      font-weight: 600;
      color: #f97316;
      margin-top: 2rem;
      margin-bottom: 0.75rem;
    }
    .prose-bento h2:first-child { margin-top: 0; }
    .prose-bento p {
      color: #a8a29e;
      font-size: 0.95rem;
      line-height: 1.7;
      margin-bottom: 1rem;
    }
    .prose-bento em { color: #fb923c; font-style: italic; }
    .prose-bento a {
      color: #fb923c;
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .prose-bento a:hover { color: #fdba74; }

    /* Jekyll Scholar bibliography overrides */
    .bibliography { list-style: none; padding: 0; margin: 0; }
    .bibliography li { margin-bottom: 1.5rem; }
    .bibliography .title { color: #ffffff; font-weight: 600; font-size: 1rem; }
    .bibliography .author { color: #a8a29e; font-size: 0.875rem; }
    .bibliography .periodical { color: #78716c; font-size: 0.875rem; font-style: italic; }
    .bibliography .links { margin-top: 0.5rem; display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .bibliography .links a,
    .bibliography .links .btn {
      display: inline-flex;
      align-items: center;
      padding: 0.25rem 0.75rem;
      font-size: 0.75rem;
      font-weight: 500;
      color: #fb923c;
      background: rgba(249, 115, 22, 0.1);
      border: 1px solid rgba(249, 115, 22, 0.3);
      border-radius: 9999px;
      text-decoration: none;
      transition: all 0.2s;
    }
    .bibliography .links a:hover,
    .bibliography .links .btn:hover {
      background: rgba(249, 115, 22, 0.25);
      color: #fdba74;
    }
    .bibliography .abbr { display: none; }
    .bibliography .abstract, .bibliography .bibtex { display: none; }
    .bibliography .abstract.open, .bibliography .bibtex.open {
      display: block;
      background: #292524;
      border: 1px solid #44403c;
      border-radius: 0.75rem;
      padding: 1rem;
      margin-top: 0.75rem;
      color: #a8a29e;
      font-size: 0.85rem;
    }
    .bibliography img.preview { display: none; }
    .bibliography .badges { margin-top: 0.5rem; }
    .bibliography .badge-link { margin-right: 0.25rem; }
  </style>
</head>

<body class="min-h-full antialiased text-gray-100 bg-glow">

  <!-- Fixed Background Image -->
  <div class="fixed top-0 w-full h-screen bg-cover bg-center -z-10" style="background-image: url('https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/99416125-6e8b-4404-9969-e774855c5494_3840w.jpg');"></div>

  <!-- Navigation -->
  <header class="bg-transparent">
    <nav class="flex max-w-7xl lg:px-8 shadow-[0_2.8px_2.2px_rgba(0,_0,_0,_0.034),_0_6.7px_5.3px_rgba(0,_0,_0,_0.048),_0_12.5px_10px_rgba(0,_0,_0,_0.06),_0_22.3px_17.9px_rgba(0,_0,_0,_0.072),_0_41.8px_33.4px_rgba(0,_0,_0,_0.086),_0_100px_80px_rgba(0,_0,_0,_0.12)] bg-white/10 border-white/20 border rounded-full mt-4 md:mt-8 mx-4 md:mx-auto mb-4 md:mb-8 pt-3 pr-2 pb-3 pl-2 backdrop-blur-md items-center justify-between">
      <div class="flex items-center space-x-3 pl-4">
        <a href="{{ '/' | relative_url }}" class="uppercase text-xl font-normal text-gray-900 tracking-tighter hover:text-orange-600 transition-colors whitespace-nowrap">
          {{ site.first_name }} {{ site.last_name }}
        </a>
      </div>

      <!-- Mobile toggle -->
      <button id="mobile-toggle" class="lg:hidden rounded-lg p-2 hover:bg-black/10 transition-colors">
        <i data-lucide="menu" class="w-6 h-6 text-gray-900" style="stroke-width: 1.5;"></i>
      </button>

      <!-- Desktop nav links -->
      <ul class="hidden lg:flex lg:flex-row lg:gap-8 items-center">
        <li><a href="{{ '/' | relative_url }}" class="hover:text-orange-600 transition-colors duration-200 text-base font-medium text-gray-900 whitespace-nowrap">Home</a></li>
        {% assign sorted_pages = site.pages | sort: 'nav_order' %}
        {% for p in sorted_pages %}
          {% if p.nav and p.autogen == null %}
            {% if p.permalink contains '://' %}
              {% assign url = p.permalink %}
            {% elsif p.permalink contains '/blog/' %}
              {% assign url = '/blog/' %}
            {% else %}
              {% assign url = p.url %}
            {% endif %}
            <li><a href="{{ url | relative_url }}" class="hover:text-orange-600 transition-colors duration-200 text-base font-medium text-gray-900 whitespace-nowrap">{{ p.title }}</a></li>
          {% endif %}
        {% endfor %}
      </ul>

      <!-- Download CV button (desktop) -->
      {% if page.cv_pdf %}
      <a href="{{ page.cv_pdf | prepend: '/assets/pdf/' | relative_url }}" target="_blank" class="relative cursor-pointer overflow-hidden transition-all duration-200 hover:scale-105 text-sm font-medium text-white rounded-full pt-3 pr-6 pb-3 pl-6 shadow-lg btn-gradient whitespace-nowrap hidden lg:inline-flex items-center gap-2">
        <div class="absolute inset-0 rounded-full pointer-events-none z-10 btn-glow-inner"></div>
        <i data-lucide="download" class="w-4 h-4 relative z-10" style="stroke-width: 1.5;"></i>
        <span class="relative z-10">Download CV</span>
      </a>
      {% endif %}
    </nav>

    <!-- Mobile dropdown menu -->
    <div id="mobile-menu" class="hidden lg:hidden mx-4 -mt-2 mb-4 z-50 relative">
      <div class="bg-stone-900 border border-stone-700 rounded-2xl p-5 shadow-2xl">
        <div class="flex items-center justify-between mb-4">
          <span class="text-sm font-medium text-stone-400">Menu</span>
          <button id="mobile-close" class="rounded-lg p-1.5 hover:bg-stone-800 transition-colors">
            <i data-lucide="x" class="w-5 h-5 text-stone-400" style="stroke-width: 1.5;"></i>
          </button>
        </div>
        <nav class="flex flex-col">
          <a href="{{ '/' | relative_url }}" class="text-white text-base font-medium hover:text-orange-400 transition-colors py-3 border-b border-stone-800">Home</a>
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.permalink contains '://' %}
                {% assign url = p.permalink %}
              {% elsif p.permalink contains '/blog/' %}
                {% assign url = '/blog/' %}
              {% else %}
                {% assign url = p.url %}
              {% endif %}
              <a href="{{ url | relative_url }}" class="text-white text-base font-medium hover:text-orange-400 transition-colors py-3 border-b border-stone-800">{{ p.title }}</a>
            {% endif %}
          {% endfor %}
        </nav>
        {% if page.cv_pdf %}
        <a href="{{ page.cv_pdf | prepend: '/assets/pdf/' | relative_url }}" target="_blank" class="mt-4 flex items-center justify-center gap-2 btn-gradient text-sm font-medium text-white rounded-full py-3 px-6">
          <i data-lucide="download" class="w-4 h-4" style="stroke-width: 1.5;"></i>
          Download CV
        </a>
        {% endif %}
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <main class="max-w-7xl lg:px-8 mx-auto px-3 sm:px-4 pb-20">

    <!-- Bento Grid Section -->
    <section class="md:p-8 bg-stone-900 border-stone-800 border rounded-[20px] md:rounded-[40px] p-3 sm:p-4 shadow-[0_2.8px_2.2px_rgba(0,_0,_0,_0.034),_0_6.7px_5.3px_rgba(0,_0,_0,_0.048),_0_12.5px_10px_rgba(0,_0,_0,_0.06),_0_22.3px_17.9px_rgba(0,_0,_0,_0.072),_0_41.8px_33.4px_rgba(0,_0,_0,_0.086),_0_100px_80px_rgba(0,_0,_0,_0.12)]">
      <div class="grid gap-4 md:auto-rows-[300px] lg:auto-rows-[360px] md:grid-cols-3">

        <!-- Hero Card (2 col, 2 row) — profile image zoomed out on right -->
        <article class="bento-card relative col-span-1 row-span-2 overflow-hidden md:col-span-2 group hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 rounded-2xl bg-stone-900 min-h-[400px] md:min-h-0">
          <!-- Profile image on the right side -->
          <img src="{{ '/assets/img/JaneodumStrip.JPEG' | relative_url }}" alt="{{ site.first_name }} {{ site.last_name }}" class="absolute right-0 top-0 h-full w-auto object-cover max-w-[45%] sm:max-w-[55%] md:max-w-[65%]" style="object-position: top center;">
          <!-- Gradient overlay from left to right for text readability -->
          <div class="absolute inset-0 bg-gradient-to-r from-stone-900 via-stone-900/80 to-transparent rounded-2xl"></div>
          <div class="absolute inset-0 flex flex-col p-4 sm:p-6 md:p-10 justify-between">
            <div class="flex items-start justify-between gap-4">
              <h1 class="max-w-sm leading-tight text-xl sm:text-2xl md:text-4xl lg:text-5xl text-white tracking-tight">
                {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }} —
                <span class="text-orange-400 transition-colors duration-300">{{ page.subtitle }}</span>
              </h1>
              <div class="flex-shrink-0 hidden sm:flex flex-col items-end gap-2">
                <div class="flex items-center gap-2 rounded-full bg-white/10 backdrop-blur-md px-3 py-1 text-xs font-medium text-white">
                  <div class="h-2 w-2 rounded-full bg-pink-400"></div>
                  Open to Collaborate
                </div>
                {%- comment -%}
                  TODO(jane): availability signal. Uncomment once you have confirmed the
                  defense month and approved the wording. Draft assumes an October 2026
                  defense, a December 2026 graduation, and that you want to signal
                  availability for research and applied ML roles.

                  <div class="flex items-center gap-2 rounded-full bg-orange-500/20 border border-orange-400/40 backdrop-blur-md px-3 py-1 text-xs font-medium text-orange-200">
                    <div class="h-2 w-2 rounded-full bg-orange-400"></div>
                    Defending Oct 2026 &middot; open to research &amp; applied ML roles
                  </div>
                {%- endcomment -%}
              </div>
            </div>
            <div class="flex items-end justify-between">
              <div>
                <p class="max-w-xs text-stone-300 text-sm sm:text-base md:text-lg font-light">
                  NES Lab (Neuro-Symbolic Computing Lab), University of Georgia — under Dr. John Miller
                </p>
                <div class="mt-4 flex items-center gap-4 flex-wrap">
                  <div class="flex items-center gap-1 text-stone-300">
                    <i data-lucide="map-pin" class="h-4 w-4" style="stroke-width: 1.5;"></i>
                    <span class="text-sm font-medium">Athens, Georgia</span>
                  </div>
                  <div class="flex items-center gap-1 text-stone-300">
                    <i data-lucide="calendar" class="h-4 w-4" style="stroke-width: 1.5;"></i>
                    <span class="text-sm font-medium">Ph.D. Candidate, 2021 to present</span>
                  </div>
                </div>
              </div>
              <button class="flex h-12 w-12 items-center justify-center rounded-full bg-white/10 backdrop-blur-md hover:bg-white/20 transition-all duration-200 hover:scale-110">
                <i data-lucide="arrow-up-right" class="h-5 w-5 text-white" style="stroke-width: 1.5;"></i>
              </button>
            </div>
          </div>
        </article>

        <!-- Research Focus Card -->
        <article class="bento-card flex flex-col overflow-hidden rounded-2xl bg-cover border border-red-800/30 p-6 justify-between" style="background-image: url('https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/6674ed65-221c-42e3-8cf9-a9c3eca77da6_800w.jpg');">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-sm font-medium text-red-300">Research Focus</span>
              <a href="{{ '/Ongoing Research/' | relative_url }}" class="flex h-8 w-8 items-center justify-center rounded-full bg-white/10 hover:bg-white/20 transition-all duration-200">
                <i data-lucide="arrow-up-right" class="h-4 w-4 text-white" style="stroke-width: 1.5;"></i>
              </a>
            </div>
            <h3 class="text-xl font-semibold mb-2 text-white">Generative AI & Forecasting</h3>
            <p class="text-sm text-red-200 mb-4">Advancing time series prediction through generative models</p>
          </div>
          <div class="space-y-2">
            <div class="flex items-center gap-2 text-sm text-white">
              <div class="h-1.5 w-1.5 rounded-full bg-orange-400"></div>
              <span>Time Series Forecasting</span>
            </div>
            <div class="flex items-center gap-2 text-sm text-white">
              <div class="h-1.5 w-1.5 rounded-full bg-red-400"></div>
              <span>Diffusion Models</span>
            </div>
            <div class="flex items-center gap-2 text-sm text-white">
              <div class="h-1.5 w-1.5 rounded-full bg-red-400"></div>
              <span>Generative AI</span>
            </div>
            <div class="flex items-center gap-2 text-sm text-white">
              <div class="h-1.5 w-1.5 rounded-full bg-orange-400"></div>
              <span>Interpretability</span>
            </div>
          </div>
        </article>

        <!-- Experience Card -->
        <article class="bento-card relative overflow-hidden rounded-2xl bg-cover border border-stone-700 p-6 flex flex-col justify-between hover:border-orange-600 hover:shadow-lg transition-all duration-300 hover:-translate-y-1" style="background-image: url('https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/1329c306-0747-4910-83ea-6f0a8b58467e_800w.jpg');">
          <div class="flex items-center justify-between">
            <span class="rounded-full bg-orange-500/20 text-orange-400 px-3 py-1 text-xs font-medium border border-orange-500/30">Experience</span>
            <a href="{{ '/cv/' | relative_url }}" class="flex h-8 w-8 items-center justify-center rounded-full bg-stone-700 hover:bg-stone-600 transition-all duration-200">
              <i data-lucide="external-link" class="h-4 w-4 text-white" style="stroke-width: 1.5;"></i>
            </a>
          </div>
          <div>
            <h3 class="text-2xl mb-2 tracking-tight text-white">ML Engineer Intern</h3>
            <p class="text-sm text-stone-400 mb-1">Stripe • Summer 2025</p>
            <p class="text-sm text-stone-400">ML models for fraud detection, Spark/Databricks pipelines at scale</p>
          </div>
        </article>

        <!-- Projects/Stats Card -->
        <article class="bento-card flex flex-col rounded-2xl bg-cover border border-pink-800/20 p-6 justify-between hover:shadow-lg transition-all duration-300 hover:-translate-y-1" style="background-image: url('https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/c374d25d-34dc-48f7-9f70-7fbc700c42c8_800w.jpg');">
          <div class="flex items-center justify-between">
            <span class="text-sm font-medium text-pink-300">Research Output</span>
            <a href="{{ '/publications/' | relative_url }}" class="flex h-8 w-8 items-center justify-center rounded-full bg-white/20 backdrop-blur hover:bg-white/30 transition-all duration-200">
              <i data-lucide="arrow-up-right" class="h-4 w-4 text-white" style="stroke-width: 1.5;"></i>
            </a>
          </div>
          <div class="mt-4">
            <p class="text-sm text-pink-200 mb-2">Projects completed</p>
            <span class="text-3xl font-semibold text-white">9+</span>
            <div class="flex gap-2 mt-3 items-center">
              <div class="flex -space-x-2">
                <div class="h-6 w-6 rounded-full bg-gradient-to-br from-orange-500 to-red-500 border-2 border-pink-400/30"></div>
                <div class="h-6 w-6 rounded-full bg-gradient-to-br from-red-500 to-pink-500 border-2 border-pink-400/30"></div>
                <div class="h-6 w-6 rounded-full bg-gradient-to-br from-yellow-500 to-orange-500 border-2 border-pink-400/30"></div>
              </div>
              <span class="text-xs text-pink-200">ML, AI & Software</span>
            </div>
          </div>
        </article>

        <!-- Education Card -->
        <article class="bento-card flex flex-col rounded-2xl bg-cover border border-stone-700 p-6 justify-between hover:border-orange-500 hover:shadow-lg transition-all duration-300 hover:-translate-y-1" style="background-image: url('https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/92a6b77d-f9a6-4e04-9d1f-9e2f3929a5ee_800w.jpg');">
          <div class="flex items-center justify-between">
            <span class="text-sm font-medium text-stone-400">Education</span>
            <div class="flex items-center gap-1 text-orange-400">
              <i data-lucide="graduation-cap" class="h-4 w-4" style="stroke-width: 1.5;"></i>
              <span class="text-xs font-medium">2021</span>
            </div>
          </div>
          <div class="mt-4">
            <p class="text-sm text-stone-400 mb-2">Ph.D. in Computer Science</p>
            <span class="text-xl text-white font-medium">University of Georgia</span>
            <p class="text-xs text-stone-500 mt-1">Expected Dec 2026 • Generative AI & Time Series</p>
          </div>
        </article>

        <!-- Tools/Skills Card (own card, not spanning) -->
        <article class="bento-card flex flex-wrap content-start gap-2 rounded-2xl bg-cover border border-stone-700 p-6 hover:border-stone-600 hover:shadow-lg transition-all duration-300 hover:-translate-y-1" style="background-image: url('https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/ed96ff8f-02b6-47fa-8b8f-4e6c07df10a4_800w.jpg');">
          <div class="w-full flex items-center justify-between mb-4">
            <span class="text-sm font-medium text-stone-400">Tools & Software</span>
          </div>
          <span class="skill-pill rounded-full bg-stone-700 border border-stone-600 px-3 py-1.5 text-sm font-medium text-stone-300 cursor-pointer">ML & Deep Learning</span>
          <span class="skill-pill rounded-full bg-stone-700 border border-stone-600 px-3 py-1.5 text-sm font-medium text-stone-300 cursor-pointer">Generative AI & Diffusion Models</span>
          <span class="skill-pill rounded-full bg-stone-700 border border-stone-600 px-3 py-1.5 text-sm font-medium text-stone-300 cursor-pointer">Time Series Forecasting</span>
          <span class="skill-pill rounded-full bg-stone-700 border border-stone-600 px-3 py-1.5 text-sm font-medium text-stone-300 cursor-pointer">NLP & Computer Vision</span>
          <span class="skill-pill rounded-full bg-stone-700 border border-stone-600 px-3 py-1.5 text-sm font-medium text-stone-300 cursor-pointer">Python</span>
          <span class="skill-pill rounded-full bg-stone-700 border border-stone-600 px-3 py-1.5 text-sm font-medium text-stone-300 cursor-pointer">PyTorch</span>
          <span class="skill-pill rounded-full bg-stone-700 border border-stone-600 px-3 py-1.5 text-sm font-medium text-stone-300 cursor-pointer">TensorFlow</span>
          <span class="skill-pill rounded-full bg-stone-700 border border-stone-600 px-3 py-1.5 text-sm font-medium text-stone-300 cursor-pointer">C/C++</span>
          <span class="skill-pill rounded-full bg-stone-700 border border-stone-600 px-3 py-1.5 text-sm font-medium text-stone-300 cursor-pointer">Java</span>
          <span class="skill-pill rounded-full bg-stone-700 border border-stone-600 px-3 py-1.5 text-sm font-medium text-stone-300 cursor-pointer">LLMs</span>
          <div class="flex items-center gap-2 mt-2">
            <div class="h-2 w-2 rounded-full bg-orange-500"></div>
            <span class="text-xs text-stone-500">Always exploring new tools</span>
          </div>
        </article>

      </div>
    </section>

    <!-- About Content Section -->
    <section class="bg-stone-900 border border-stone-800 rounded-[20px] md:rounded-[40px] mt-8 p-4 sm:p-6 md:p-10 shadow-[0_2.8px_2.2px_rgba(0,0,0,0.034),0_6.7px_5.3px_rgba(0,0,0,0.048),0_12.5px_10px_rgba(0,0,0,0.06),0_22.3px_17.9px_rgba(0,0,0,0.072),0_41.8px_33.4px_rgba(0,0,0,0.086),0_100px_80px_rgba(0,0,0,0.12)]">
      <div class="prose-bento max-w-none">
        {{ content }}
      </div>
    </section>

    <!-- Selected Publications Section -->
    {% if page.selected_papers %}
    <section class="bg-stone-900 border border-stone-800 rounded-[20px] md:rounded-[40px] mt-8 p-4 sm:p-6 md:p-10 shadow-[0_2.8px_2.2px_rgba(0,0,0,0.034),0_6.7px_5.3px_rgba(0,0,0,0.048),0_12.5px_10px_rgba(0,0,0,0.06),0_22.3px_17.9px_rgba(0,0,0,0.072),0_41.8px_33.4px_rgba(0,0,0,0.086),0_100px_80px_rgba(0,0,0,0.12)]">
      <h2 class="text-2xl font-bold mb-6 text-white">
        <a href="{{ '/publications/' | relative_url }}" class="hover:text-orange-400 transition-colors">Selected Publications</a>
      </h2>
      {% bibliography --query @*[selected=true] %}
    </section>
    {% endif %}

    <!-- Footer -->
    <footer class="overflow-hidden bg-stone-900 border-stone-800 rounded-[20px] md:rounded-[40px] border-t mt-12 py-8 md:py-12 px-4 sm:px-6 md:px-12 shadow-[0_2.8px_2.2px_rgba(0,_0,_0,_0.034),_0_6.7px_5.3px_rgba(0,_0,_0,_0.048),_0_12.5px_10px_rgba(0,_0,_0,_0.06),_0_22.3px_17.9px_rgba(0,_0,_0,_0.072),_0_41.8px_33.4px_rgba(0,_0,_0,_0.086),_0_100px_80px_rgba(0,_0,_0,_0.12)]">
      <div class="mx-auto max-w-7xl grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 text-stone-300">

        <!-- Let's Connect -->
        <div>
          <h4 class="text-lg font-semibold mb-4 tracking-tight text-white">Let's Connect</h4>
          <p class="text-sm font-light max-w-xs text-stone-400">Open to research collaborations, speaking opportunities, and academic partnerships.</p>
          <p class="mt-4 text-xs text-stone-500">&copy; {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}. All rights reserved.</p>
        </div>

        <!-- Contact -->
        <div>
          <h5 class="text-sm font-semibold mb-3 tracking-tight text-white">Contact</h5>
          <ul class="space-y-2 text-sm font-light text-stone-400">
            <li><a href="mailto:{{ site.data.socials.email }}" class="hover:text-orange-400 transition-colors duration-200">{{ site.data.socials.email }}</a></li>
            <li class="hover:text-orange-400 transition-colors duration-200">Athens, Georgia</li>
            <li class="hover:text-orange-400 transition-colors duration-200">University of Georgia</li>
          </ul>
        </div>

        <!-- Resources -->
        <div>
          <h5 class="text-sm font-semibold mb-3 tracking-tight text-white">Resources</h5>
          <ul class="space-y-2 text-sm font-light text-stone-400">
            {% assign sorted_pages = site.pages | sort: 'nav_order' %}
            {% for p in sorted_pages %}
              {% if p.nav and p.autogen == null %}
                {% if p.permalink contains '://' %}
                  {% assign url = p.permalink %}
                {% elsif p.permalink contains '/blog/' %}
                  {% assign url = '/blog/' %}
                {% else %}
                  {% assign url = p.url %}
                {% endif %}
                <li><a href="{{ url | relative_url }}" class="hover:text-orange-400 transition-colors duration-200">{{ p.title }}</a></li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>

        <!-- Social -->
        <div>
          <h5 class="text-sm font-semibold mb-3 tracking-tight text-white">Social</h5>
          <div class="flex space-x-4">
            {% if site.data.socials.linkedin_username %}
            <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}" target="_blank" rel="noopener" class="text-stone-500 hover:text-orange-400 transition-all duration-200 hover:scale-110">
              <i data-lucide="linkedin" class="w-5 h-5" style="stroke-width: 1.5;"></i>
            </a>
            {% endif %}
            {% if site.data.socials.scholar_userid %}
            <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}" target="_blank" rel="noopener" class="text-stone-500 hover:text-orange-400 transition-all duration-200 hover:scale-110">
              <i data-lucide="graduation-cap" class="w-5 h-5" style="stroke-width: 1.5;"></i>
            </a>
            {% endif %}
            {% if site.data.socials.medium_username %}
            <a href="https://medium.com/@{{ site.data.socials.medium_username }}" target="_blank" rel="noopener" class="text-stone-500 hover:text-orange-400 transition-all duration-200 hover:scale-110">
              <i data-lucide="book-open" class="w-5 h-5" style="stroke-width: 1.5;"></i>
            </a>
            {% endif %}
            {% if site.data.socials.instagram_id %}
            <a href="https://instagram.com/{{ site.data.socials.instagram_id }}" target="_blank" rel="noopener" class="text-stone-500 hover:text-orange-400 transition-all duration-200 hover:scale-110">
              <i data-lucide="instagram" class="w-5 h-5" style="stroke-width: 1.5;"></i>
            </a>
            {% endif %}
            {% if site.data.socials.email %}
            <a href="mailto:{{ site.data.socials.email }}" class="text-stone-500 hover:text-orange-400 transition-all duration-200 hover:scale-110">
              <i data-lucide="mail" class="w-5 h-5" style="stroke-width: 1.5;"></i>
            </a>
            {% endif %}
          </div>
        </div>

      </div>
    </footer>

  </main>

  <script>
    // Initialize Lucide icons
    lucide.createIcons();

    // Mobile menu toggle
    (function() {
      var toggle = document.getElementById('mobile-toggle');
      var close = document.getElementById('mobile-close');
      var menu = document.getElementById('mobile-menu');
      if (!menu) return;

      if (toggle) {
        toggle.addEventListener('click', function() {
          menu.classList.toggle('hidden');
        });
      }
      if (close) {
        close.addEventListener('click', function() {
          menu.classList.add('hidden');
        });
      }
      // Close menu when clicking a nav link
      menu.querySelectorAll('nav a').forEach(function(link) {
        link.addEventListener('click', function() {
          menu.classList.add('hidden');
        });
      });
    })();
  </script>

</body>
</html>
